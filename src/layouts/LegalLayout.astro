---
// File: src/layouts/LegalLayout.astro
// Purpose: Shared layout wrapper for Foseer legal pages.

import Layout from '~/layouts/PageLayout.astro';

export interface Props {
  title: string;
  description: string;
  lastUpdated?: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<Layout metadata={{ title, description }}>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <header class="mb-10 border-b border-slate-200 dark:border-slate-700 pb-8">
        <p class="text-sm uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-3">Legal</p>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white font-heading mb-4">
          {title}
        </h1>
        {lastUpdated && <p class="text-sm text-gray-600 dark:text-slate-400">Last updated: {lastUpdated}</p>}
      </header>

      <div class="prose prose-lg max-w-none dark:prose-invert dark:prose-headings:text-slate-100 prose-a:text-blue-600 dark:prose-a:text-blue-400">
        <slot />
      </div>
    </div>
  </section>
</Layout>
