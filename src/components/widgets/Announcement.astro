---
// src/components/widgets/Announcement.astro
// Compact, optional site-wide announcement bar for Foseer.com

interface Props {
  enabled?: boolean;
  label?: string;
  message?: string;
  href?: string;
}

const {
  enabled = false,
  label = 'Beta',
  message = 'Foseer is in beta. Layout and features may change.',
  href = '',
} = Astro.props;
---

{enabled && (
  <div class="text-xs md:text-sm bg-slate-900 text-slate-100 dark:bg-slate-900/80 dark:text-slate-200 border-b border-slate-800">
    <div class="mx-auto flex max-w-6xl items-center gap-3 px-3 py-2">
      <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-emerald-300">
        {label}
      </span>

      <p class="truncate">
        {message}
      </p>

      {href && (
        <a
          href={href}
          class="ml-auto text-[0.7rem] font-medium underline underline-offset-2"
        >
          Learn more
        </a>
      )}
    </div>
  </div>
)}
