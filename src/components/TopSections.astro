---
// File: src/components/TopSections.astro
// Purpose: Highlight the strongest sections from the Foseer taxonomy with a short list of topics.

import { getTopSections, getTopicsBySection } from "~/utils/foseer-taxonomy";

const sections = getTopSections(4);
---

<section class="py-16 sm:py-20 bg-slate-50 dark:bg-slate-950/60">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <header class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-sky-500">
          Key areas
        </p>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100 sm:text-3xl">
          Main sections of the site
        </h2>
      </div>
      <p class="max-w-xl text-sm text-slate-600 dark:text-slate-400">
        Each section groups together related topics, workflows, and case studies. Start from a section if you have a broad goal in mind.
      </p>
    </header>

    {sections.length === 0 ? (
      <p class="text-sm text-slate-500 dark:text-slate-400">
        No sections are available yet. Add taxonomy data to start structuring the site.
      </p>
    ) : (
      <div class="grid gap-6 md:grid-cols-2">
        {sections.map((section) => {
          const topics = getTopicsBySection(section.id).slice(0, 4);
          return (
            <div
              class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900"
            >
              <div class="mb-3 flex items-center justify-between gap-3">
                <h3 class="text-xl font-semibold text-slate-900 dark:text-slate-50">
                  {section.title}
                </h3>
                <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-medium text-sky-700 dark:bg-sky-900/40 dark:text-sky-300">
                  Core section
                </span>
              </div>

              {section.description && (
                <p class="mb-4 text-sm text-slate-600 dark:text-slate-400">
                  {section.description}
                </p>
              )}

              {topics.length > 0 && (
                <ul class="mb-4 space-y-2 text-sm">
                  {topics.map((topic) => (
                    <li key={topic.id}>
                      <a
                        href={`/sections/${topic.sectionSlug}/${topic.slug}/`}
                        class="inline-flex items-center gap-1 text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
                      >
                        <span class="h-1.5 w-1.5 rounded-full bg-sky-500" />
                        <span>{topic.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}

              <div class="mt-auto pt-2">
                <a
                  href={`/sections/${section.slug}/`}
                  class="inline-flex items-center gap-1 text-sm font-medium text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
                >
                  <span>Open section overview</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</section>
