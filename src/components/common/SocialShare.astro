---
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-flex items-center' } = Astro.props;
---

<div class={className}>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Share on X"
    data-aw-social-share="twitter"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-x"
      class="w-6 h-6 text-gray-500 dark:text-slate-400 hover:text-black dark:hover:text-slate-200"
    />
  </button>
  <button class="ml-2 rtl:ml-0 rtl:mr-2" title="Share on Facebook" data-aw-social-share="facebook" data-aw-url={url}
    ><Icon
      name="tabler:brand-facebook"
      class="w-6 h-6 text-gray-500 dark:text-slate-400 hover:text-black dark:hover:text-slate-200"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Share on Linkedin"
    data-aw-social-share="linkedin"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-linkedin"
      class="w-6 h-6 text-gray-500 dark:text-slate-400 hover:text-black dark:hover:text-slate-200"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Share on Whatsapp"
    data-aw-social-share="whatsapp"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-whatsapp"
      class="w-6 h-6 text-gray-500 dark:text-slate-400 hover:text-black dark:hover:text-slate-200"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Share by Email"
    data-aw-social-share="mail"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:mail"
      class="w-6 h-6 text-gray-500 dark:text-slate-400 hover:text-black dark:hover:text-slate-200"
    />
  </button>
</div>
