---
// File: src/components/common/Header.astro
// Purpose: Compact, responsive header for Foseer navigation.
//
// Responsive behavior:
// - Desktop (lg+): Full horizontal navigation with dropdowns
// - Mobile/Tablet (< lg): Hamburger menu with slide-out drawer

import foseerLogo from '~/assets/logo/foseer-logo.svg';
import { headerData } from '~/navigation';
---

<header class="relative z-50 w-full border-b border-gray-200 bg-white/95 backdrop-blur-sm dark:border-gray-800 dark:bg-gray-900/95">
  <div class="mx-auto flex max-w-screen-xl items-center justify-between px-4 py-2.5">
    <!-- Logo -->
    <a href="/" class="flex items-center flex-shrink-0">
      <img src={foseerLogo.src} alt="Foseer" width="1011" height="243" class="h-[36px] w-auto" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
      {headerData.links.map((item: any) => (
        <div class="relative group">
          {item.links ? (
            <button
              class="px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 rounded-md transition-colors cursor-pointer"
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.text}
            </button>
          ) : (
            <a
              href={item.href}
              class="px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 rounded-md transition-colors"
            >
              {item.text}
            </a>
          )}

          {item.links && (
            <div
              class="absolute left-0 top-full hidden flex-col gap-0.5 min-w-[180px] rounded-lg border border-gray-200 bg-white py-2 shadow-lg ring-1 ring-black/5 group-hover:flex dark:border-gray-700 dark:bg-gray-800 z-50"
              role="menu"
            >
              {item.links.map((sub) => (
                <a
                  href={sub.href}
                  class="px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white transition-colors"
                  role="menuitem"
                >
                  {sub.text}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- Right side actions -->
    <div class="hidden lg:flex items-center gap-3">
      <a
        href={headerData.actions[0].href}
        class="rounded-full border border-gray-300 dark:border-gray-600 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
      >
        {headerData.actions[0].text}
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      type="button"
      class="lg:hidden p-2 -mr-2 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-md"
      aria-label="Toggle menu"
      aria-expanded="false"
      data-toggle-menu
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-nav"
    class="fixed inset-0 z-40 hidden opacity-0 bg-black/50 lg:hidden transition-opacity duration-300"
    aria-hidden="true"
  >
    <div
      class="fixed inset-y-0 right-0 z-50 w-full max-w-xs overflow-y-auto bg-white px-6 py-4 shadow-xl dark:bg-gray-900 transform transition-transform duration-300 ease-out translate-x-full"
      role="dialog"
      aria-modal="true"
      aria-label="Mobile navigation"
    >
      <div class="flex items-center justify-between mb-6">
        <span class="text-lg font-semibold text-gray-900 dark:text-white">Menu</span>
        <button
          type="button"
          class="p-2 -mr-2 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-md"
          aria-label="Close menu"
          data-close-menu
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="space-y-1" aria-label="Mobile navigation">
        {headerData.links.map((item: any) => (
          <div class="border-b border-gray-100 dark:border-gray-800 pb-2 last:border-0">
            {item.links ? (
              <details class="group">
                <summary
                  class="flex items-center justify-between py-3 text-base font-medium text-gray-900 dark:text-white cursor-pointer list-none"
                >
                  {item.text}
                  <svg class="h-5 w-5 text-gray-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="mt-2 space-y-2 pl-4">
                  {item.links.map((sub: any) => (
                    <a
                      href={sub.href}
                      class="block py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white"
                    >
                      {sub.text}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={item.href}
                class="block py-3 text-base font-medium text-gray-900 dark:text-white hover:text-gray-700 dark:hover:text-gray-300"
              >
                {item.text}
              </a>
            )}
          </div>
        ))}

        <div class="pt-4 border-t border-gray-100 dark:border-gray-800">
          <a
            href={headerData.actions[0].href}
            class="flex items-center justify-center rounded-lg bg-gray-900 dark:bg-white px-4 py-3 text-base font-medium text-white dark:text-gray-900 hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors"
          >
            {headerData.actions[0].text}
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle functionality
  const menuButton = document.querySelector('[data-toggle-menu]');
  const closeButton = document.querySelector('[data-close-menu]');
  const mobileNav = document.getElementById('mobile-nav');
  const mobileNavPanel = mobileNav?.querySelector('[role="dialog"]');

  function openMenu() {
    // Remove hidden first to allow layout calculation
    mobileNav?.classList.remove('hidden');
    menuButton?.setAttribute('aria-expanded', 'true');
    
    // Use requestAnimationFrame to ensure layout is computed before animating
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        mobileNav?.classList.remove('opacity-0');
        mobileNavPanel?.classList.remove('translate-x-full');
      });
    });
    
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    // Animate out
    mobileNav?.classList.add('opacity-0');
    mobileNavPanel?.classList.add('translate-x-full');
    
    // Wait for animation to complete before hiding
    setTimeout(() => {
      mobileNav?.classList.add('hidden');
      menuButton?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }, 300);
  }

  menuButton?.addEventListener('click', openMenu);
  closeButton?.addEventListener('click', closeMenu);
  mobileNav?.addEventListener('click', (e) => {
    if (e.target === mobileNav) closeMenu();
  });

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileNav?.classList.contains('hidden')) {
      closeMenu();
    }
  });
</script>
