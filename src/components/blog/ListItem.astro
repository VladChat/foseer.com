---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { resolvePostImage, generateImageAlt } from '~/utils/post-image';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await resolvePostImage(post.image, post.slug);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  class={`max-w-none grid gap-6 md:gap-8 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade ${image ? 'md:grid-cols-2' : ''}`}
>
  {
    image &&
      (link ? (
        <a class="relative block group rounded-lg overflow-hidden" href={link ?? 'javascript:void(0)'}>
          <div class="relative h-0 pb-[56.25%] md:pb-[75%] md:h-64 lg:pb-[56.25%] overflow-hidden bg-gray-200 dark:bg-slate-700 rounded-lg shadow-md transition-transform duration-30 group-hover:scale-[1.02]">
            {image && (
              <Image
                src={image}
                class="absolute inset-0 object-cover w-full h-full rounded-lg"
                widths={[400, 800, 1200]}
                width={1200}
                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                alt={generateImageAlt(post.title)}
                aspectRatio="16:9"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
        </a>
      ) : (
        <div class="relative h-0 pb-[56.25%] md:pb-[75%] md:h-64 lg:pb-[56.25%] overflow-hidden bg-gray-200 dark:bg-slate-700 rounded-lg shadow-md">
          {image && (
            <Image
              src={image}
              class="absolute inset-0 object-cover w-full h-full rounded-lg"
              widths={[400, 800, 1200]}
              width={1200}
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
              alt={generateImageAlt(post.title)}
              aspectRatio="16:9"
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      ))
 }
  <div class="mt-4 md:mt-0 md:pl-6">
    <header>
      <div class="mb-3 flex flex-wrap items-center gap-2 text-sm text-muted dark:text-slate-400 border-b border-slate-200 dark:border-slate-700 pb-3">
        <div class="flex items-center gap-1">
          <Icon name="tabler:calendar-event" class="w-4 h-4 text-primary dark:text-blue-400" />
          <time datetime={String(post.publishDate)} class="text-sm font-medium text-gray-600 dark:text-slate-300">
            {getFormattedDate(post.publishDate)}
          </time>
        </div>
        {post.author && (
          <div class="flex items-center gap-1">
            <Icon name="tabler:user" class="w-4 h-4 text-primary dark:text-blue-400" />
            <span class="text-sm font-medium text-gray-700 dark:text-slate-300">
              {post.author.replaceAll('-', ' ')}
            </span>
          </div>
        )}
        {post.category && (
          <div class="flex items-center gap-1">
            <Icon name="tabler:tag" class="w-4 h-4 text-primary dark:text-blue-400" />
            <a 
              href={getPermalink(post.category.slug, 'category')}
              class="text-sm font-medium text-primary hover:underline transition-colors bg-primary/10 dark:bg-blue-400/10 px-2 py-1 rounded-full"
            >
              {post.category.title}
            </a>
          </div>
        )}
      </div>
      <h2 class="text-xl sm:text-2xl font-bold leading-tight mb-3 font-heading text-gray-900 dark:text-white group-hover:text-primary dark:group-hover:text-blue-400 transition-colors duration-200">
        {
          link ? (
            <a
              class="inline-block hover:text-primary dark:hover:text-blue-400 transition-colors duration-200"
              href={link}
            >
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </h2>
    </header>

    {post.excerpt && (
      <p class="flex-grow text-muted dark:text-slate-300 text-base leading-relaxed mb-4 font-light text-justify">
        {post.excerpt}
      </p>
    )}
    
    {post.tags && Array.isArray(post.tags) && post.tags.length > 0 && (
      <footer class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-700">
        <PostTags tags={post.tags} />
      </footer>
    )}
  </div>
</article>
