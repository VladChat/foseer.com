---
// File: src/pages/ownership-funding.astro
// Purpose: Foseer Ownership & Funding page.

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Ownership & Funding',
  description: 'Foseer is an independent digital publication.',
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <header class="mb-12 border-b border-slate-200 dark:border-slate-700 pb-8">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white font-heading mb-4">
          Ownership &amp; Funding
        </h1>
      </header>

      <div class="prose prose-lg dark:prose-invert">
        <p class="text-lg text-gray-700 dark:text-slate-300 leading-relaxed">
          Foseer is an independent digital publication.
        </p>

        <h2>Editorial Independence</h2>
        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          Foseer's editorial direction, publishing standards, and site policies are controlled internally by the publication. We aim to make editorial decisions based on relevance, clarity, usefulness, and reader value.
        </p>

        <h2>Endorsements and Sponsorships</h2>
        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          References to products, companies, institutions, or public figures do not imply endorsement, sponsorship, or partnership unless clearly stated otherwise.
        </p>

        <h2>Sponsored Content</h2>
        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          If Foseer publishes sponsored content, paid partnerships, affiliate-supported material, or other compensated placements in the future, we will aim to label them clearly and distinguish them from ordinary editorial coverage.
        </p>

        <div class="mt-8 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
          <p class="text-sm text-gray-600 dark:text-slate-400 mb-0">
            For business or partnership inquiries, contact <a href="mailto:info@foseer.com" class="text-primary hover:underline">info@foseer.com</a> or call <a href="tel:+12245329236" class="text-primary hover:underline">(224) 532-9236</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
