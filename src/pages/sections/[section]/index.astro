---
/*
 File: src/pages/sections/[section]/index.astro
 Purpose: Section landing page (static generation; lists topics inside a section)
*/

import Layout from '~/layouts/PageLayout.astro';
import { getSections, getSectionBySlug } from '~/utils/foseer-taxonomy';

/**
 * REQUIRED for static builds
 * Generates all /sections/{section}/ pages
 */
export async function getStaticPaths() {
  const sections = getSections();

  return sections.map((s) => ({
    params: { section: s.slug },
  }));
}

const { section } = Astro.params;

const sectionData = getSectionBySlug(section);

if (!sectionData) {
  throw new Error(`Section not found: ${section}`);
}
---

<Layout metadata={{ title: sectionData.title }}>
  <section class="max-w-6xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <header class="mb-12 border-b border-slate-200 dark:border-slate-700 pb-8">
      <div class="mb-4 flex items-center gap-3 text-sm text-muted dark:text-slate-400">
        <span class="text-primary dark:text-blue-400 font-semibold uppercase tracking-wide text-xs">Section</span>
        <span class="text-gray-300 dark:text-slate-600">•</span>
        <time datetime={new Date().toISOString()} class="text-sm font-medium text-gray-600 dark:text-slate-300">
          Updated {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900 dark:text-white font-heading">
        {sectionData.title}
      </h1>

      {sectionData.description && (
        <p class="text-lg text-muted dark:text-slate-300 max-w-3xl leading-relaxed font-light text-justify">
          {sectionData.description}
        </p>
      )}
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sectionData.topics.map((topic) => (
        <a
          href={`/sections/${sectionData.slug}/${topic.slug}`}
          class="block rounded-xl border border-slate-200 p-6 hover:border-primary hover:shadow-lg transition-all duration-300 hover:-translate-y-1 dark:border-slate-700 dark:hover:border-blue-400 dark:hover:shadow-blue-400/10 bg-white dark:bg-slate-800/50"
        >
          <div class="mb-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-primary dark:text-blue-400 mb-2">
            <span class="h-1.5 w-1.5 rounded-full bg-primary dark:bg-blue-400" />
            <span>Topic Focus</span>
          </div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white group-hover:text-primary dark:group-hover:text-blue-400 transition-colors">
            {topic.title}
          </h3>

          {topic.description && (
            <p class="text-sm text-muted dark:text-slate-400 leading-relaxed text-justify">
              {topic.description}
            </p>
          )}
          <div class="mt-4 flex items-center text-sm text-primary dark:text-blue-400 font-medium group-hover:text-secondary dark:group-hover:text-blue-300 transition-colors">
            <span>Explore coverage</span>
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
