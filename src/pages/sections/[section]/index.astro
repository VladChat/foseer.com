---
/*
 File: src/pages/sections/[section]/index.astro
 Purpose: Section landing page (static generation; lists topics inside a section)
*/

import Layout from '~/layouts/PageLayout.astro';
import { getSections, getSectionBySlug } from '~/utils/foseer-taxonomy';

/**
 * REQUIRED for static builds
 * Generates all /sections/{section}/ pages
 */
export async function getStaticPaths() {
  const sections = getSections();

  return sections.map((s) => ({
    params: { section: s.slug },
  }));
}

const { section } = Astro.params;

const sectionData = getSectionBySlug(section);

if (!sectionData) {
  throw new Error(`Section not found: ${section}`);
}
---

<Layout title={sectionData.title}>
  <section class="max-w-5xl mx-auto py-12">
    <header class="mb-10">
      <h1 class="text-3xl font-bold mb-3">
        {sectionData.title}
      </h1>

      {sectionData.description && (
        <p class="text-gray-600 max-w-2xl">
          {sectionData.description}
        </p>
      )}
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sectionData.topics.map((topic) => (
        <a
          href={`/sections/${sectionData.slug}/${topic.slug}/`}
          class="block rounded-lg border border-gray-200 p-5 hover:border-gray-400 transition"
        >
          <h3 class="font-semibold mb-2">
            {topic.title}
          </h3>

          {topic.description && (
            <p class="text-sm text-gray-600">
              {topic.description}
            </p>
          )}
        </a>
      ))}
    </div>
  </section>
</Layout>
