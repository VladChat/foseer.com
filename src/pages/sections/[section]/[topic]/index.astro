---
/*
 File: src/pages/sections/[section]/[topic]/index.astro
 Purpose: Topic explainer page with related posts (static generation)
*/

import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import { getSections, getTopicBySlugs } from '~/utils/foseer-taxonomy';
import { getPostsByTopicSlug } from '~/utils/topic-posts';
import { getPermalink } from '~/utils/permalinks';
import { resolvePostImage, generateImageAlt } from '~/utils/post-image';

/**
 * REQUIRED for static builds
 * Generates all /sections/{section}/{topic} pages
 */
export async function getStaticPaths() {
  const sections = getSections();

  const paths: Array<{ params: { section: string; topic: string } }> = [];

  for (const section of sections) {
    for (const topic of section.topics) {
      paths.push({
        params: {
          section: section.slug,
          topic: topic.slug,
        },
      });
    }
  }

  return paths;
}

const { section, topic } = Astro.params;

const topicData = getTopicBySlugs(section, topic);
if (!topicData) {
  throw new Error(`Topic not found: ${section}/${topic}`);
}

const posts = await getPostsByTopicSlug(topicData.slug);
---

<Layout metadata={{ title: topicData.title }}>
  <section class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <header class="mb-12 border-b border-slate-200 dark:border-slate-700 pb-8">
      <div class="mb-4 flex items-center gap-3 text-sm text-muted dark:text-slate-400">
        <span class="text-primary dark:text-blue-400 font-semibold uppercase tracking-wide text-xs">Topic</span>
        <span class="text-gray-300 dark:text-slate-600">•</span>
        <span class="text-sm font-medium text-gray-600 dark:text-slate-300">
          {posts.length} articles
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900 dark:text-white font-heading">
        {topicData.title}
      </h1>

      {topicData.description && (
        <p class="text-lg text-muted dark:text-slate-300 leading-relaxed font-light text-justify">
          {topicData.description}
        </p>
      )}
    </header>

    <section class="bg-gradient-to-r from-primary/5 to-blue-50/5 dark:from-blue-900/10 dark:to-slate-800/20 rounded-xl p-8 mb-12 border border-slate-200 dark:border-slate-700">
      <h2 class="text-xl font-bold mb-4 text-gray-900 dark:text-white font-heading">
        Why this topic matters right now
      </h2>
      <p class="text-gray-700 dark:text-slate-300 leading-relaxed text-justify">
        This topic is gaining attention due to recent developments, public
        interest, and its broader impact across related areas. Stay informed with our
        comprehensive coverage and analysis of the latest trends and implications.
      </p>
    </section>

    {posts.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white font-heading">
          Latest coverage
        </h2>
        <div class="space-y-6">
          {await Promise.all(posts.map(async (post) => {
            const thumbnail = await resolvePostImage(post.data.image, post.id);
            const imageAlt = generateImageAlt(post.data.title, post.data.excerpt);
            
            return (
              <article class="border-b border-slate-200 dark:border-slate-700 pb-6 last:border-b-0 last:pb-0">
                <div class="flex gap-4 sm:gap-5">
                  {thumbnail && (
                    <a href={getPermalink(`/article/${post.id}`, 'post')} class="flex-shrink-0 w-20 sm:w-28 md:w-32 group">
                      <div class="relative aspect-video overflow-hidden rounded-lg bg-slate-100 dark:bg-slate-800 shadow-sm transition-transform duration-300 group-hover:scale-105">
                        <Image
                          src={thumbnail}
                          alt={imageAlt}
                          width={320}
                          height={180}
                          sizes="(max-width: 768px) 80px, 112px"
                          loading="lazy"
                          decoding="async"
                          quality={80}
                          class="h-full w-full object-cover"
                        />
                      </div>
                    </a>
                  )}
                  <div class="flex flex-col flex-grow min-w-0">
                    <h3 class="text-base sm:text-lg md:text-xl font-bold font-heading text-gray-900 dark:text-white group-hover:text-primary dark:group-hover:text-blue-400 transition-colors duration-200 line-clamp-2">
                      <a href={getPermalink(`/article/${post.id}`, 'post')} class="hover:text-primary dark:hover:text-blue-400">
                        {post.data.title}
                      </a>
                    </h3>
                    <div class="mt-2 flex flex-wrap items-center gap-3 text-xs sm:text-sm text-muted dark:text-slate-400">
                      <time datetime={String(post.data.publishDate)} class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-slate-400 dark:text-slate-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <span class="truncate">{new Date(post.data.publishDate as string | number | Date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                      </time>
                      {post.data.author && (
                        <span class="flex items-center gap-1.5">
                          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-slate-400 dark:text-slate-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                          </svg>
                          <span class="truncate">{post.data.author}</span>
                        </span>
                      )}
                    </div>
                    {post.data.excerpt && (
                      <p class="hidden sm:block mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-2">
                        {post.data.excerpt}
                      </p>
                    )}
                  </div>
                </div>
              </article>
            );
          }))}
        </div>
      </section>
    )}
  </section>
</Layout>
