---
/*
 File: src/pages/sections/[section]/[topic]/index.astro
 Purpose: Topic explainer page with related posts (static generation)
*/

import Layout from '~/layouts/PageLayout.astro';
import { getSections, getTopicBySlugs } from '~/utils/foseer-taxonomy';
import { getPostsByTopicSlug } from '~/utils/topic-posts';

/**
 * REQUIRED for static builds
 * Generates all /sections/{section}/{topic} pages
 */
export async function getStaticPaths() {
  const sections = getSections();

  const paths = [];

  for (const section of sections) {
    for (const topic of section.topics) {
      paths.push({
        params: {
          section: section.slug,
          topic: topic.slug,
        },
      });
    }
  }

  return paths;
}

const { section, topic } = Astro.params;

const topicData = getTopicBySlugs(section, topic);
if (!topicData) {
  throw new Error(`Topic not found: ${section}/${topic}`);
}

const posts = await getPostsByTopicSlug(topicData.slug);
---

<Layout title={topicData.title}>
  <section class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <header class="mb-12 border-b border-slate-200 dark:border-slate-700 pb-8">
      <div class="mb-4 flex items-center gap-3 text-sm text-muted dark:text-slate-400">
        <span class="text-primary dark:text-blue-400 font-semibold uppercase tracking-wide text-xs">Topic</span>
        <span class="text-gray-300 dark:text-slate-600">•</span>
        <span class="text-sm font-medium text-gray-600 dark:text-slate-300">
          {posts.length} articles
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900 dark:text-white font-heading">
        {topicData.title}
      </h1>

      {topicData.description && (
        <p class="text-lg text-muted dark:text-slate-300 leading-relaxed font-light text-justify">
          {topicData.description}
        </p>
      )}
    </header>

    <section class="bg-gradient-to-r from-primary/5 to-blue-50/5 dark:from-blue-900/10 dark:to-slate-800/20 rounded-xl p-8 mb-12 border border-slate-200 dark:border-slate-700">
      <h2 class="text-xl font-bold mb-4 text-gray-900 dark:text-white font-heading">
        Why this topic matters right now
      </h2>
      <p class="text-gray-700 dark:text-slate-300 leading-relaxed text-justify">
        This topic is gaining attention due to recent developments, public
        interest, and its broader impact across related areas. Stay informed with our
        comprehensive coverage and analysis of the latest trends and implications.
      </p>
    </section>

    {posts.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white font-heading">
          Latest coverage
        </h2>
        <div class="space-y-6">
          {posts.map((post) => (
            <article class="border-b border-slate-200 dark:border-slate-700 pb-6 last:border-b-0 last:pb-0">
              <h3 class="text-xl font-semibold mb-2 text-gray-900 dark:text-white group-hover:text-primary dark:group-hover:text-blue-400 transition-colors">
                <a href={post.slug} class="hover:text-primary dark:hover:text-blue-400 transition-colors duration-200">
                  {post.data.title}
                </a>
              </h3>
              <div class="flex flex-wrap items-center gap-4 text-sm text-muted dark:text-slate-400 mb-2">
                <time datetime={String(post.data.publishDate)} class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  {new Date(post.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {post.data.author && (
                  <span class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    {post.data.author}
                  </span>
                )}
                {post.data.category && (
                  <span class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 0 014-4z"></path>
                    </svg>
                    {post.data.category.title}
                  </span>
                )}
              </div>
              {post.data.excerpt && (
                <p class="text-muted dark:text-slate-400 leading-relaxed text-justify mt-2">
                  {post.data.excerpt}
                </p>
              )}
            </article>
          ))}
        </div>
      </section>
    )}
  </section>
</Layout>
