---
/*
 File: src/pages/sections/[section]/[topic]/index.astro
 Purpose: Topic explainer page with related posts
*/

import { getTopicBySlugs } from '~/utils/foseer-taxonomy';
import { getPostsByTopicSlug } from '~/utils/topic-posts';
import Layout from '~/layouts/PageLayout.astro';

const { section, topic } = Astro.params;

const topicData = getTopicBySlugs(section, topic);
if (!topicData) {
  throw new Error(`Topic not found: ${section}/${topic}`);
}

const posts = await getPostsByTopicSlug(topicData.slug);
---

<Layout title={topicData.title}>
  <section class="max-w-3xl mx-auto py-12">
    <header class="mb-10">
      <h1 class="text-3xl font-bold mb-4">{topicData.title}</h1>
      {topicData.description && (
        <p class="text-gray-600 text-lg">{topicData.description}</p>
      )}
    </header>

    {posts.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xl font-semibold mb-4">Latest coverage</h2>
        <ul class="space-y-3">
          {posts.map((post) => (
            <li>
              <a href={post.slug} class="text-blue-600 hover:underline">
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </section>
</Layout>
