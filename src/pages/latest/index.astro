---
// File: src/pages/latest/index.astro
// Purpose: Latest coverage page - lists all articles chronologically.

import type { GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import EditorialStoryCard from '~/components/EditorialStoryCard.astro';
import LoadMore from '~/components/LoadMore.astro';
import { fetchPosts } from '~/utils/blog';
import type { Post } from '~/types';

export const prerender = true;

export const getStaticPaths = (async () => {
  return [{ params: {} }];
}) satisfies GetStaticPaths;

const posts = await fetchPosts();

const DUPLICATE_WINDOW_HOURS = 168;
const STOP_WORDS = new Set([
  'a',
  'an',
  'and',
  'as',
  'at',
  'for',
  'from',
  'how',
  'in',
  'into',
  'is',
  'it',
  'its',
  'of',
  'on',
  'or',
  'over',
  'rare',
  'reported',
  'the',
  'to',
  'up',
  'with',
]);

const extractTitleTokens = (title: string): Set<string> => {
  const normalized = title
    .toLowerCase()
    .replace(/[^a-z0-9\s]/g, ' ')
    .split(/\s+/)
    .map((token) => token.trim())
    .filter((token) => token.length >= 3 && !STOP_WORDS.has(token));
  return new Set(normalized);
};

const titleSimilarityScore = (a: string, b: string): number => {
  const aTokens = extractTitleTokens(a);
  const bTokens = extractTitleTokens(b);
  if (aTokens.size === 0 || bTokens.size === 0) return 0;

  let overlap = 0;
  for (const token of aTokens) {
    if (bTokens.has(token)) overlap += 1;
  }
  const union = new Set([...aTokens, ...bTokens]).size;
  return union === 0 ? 0 : overlap / union;
};

const normalizeSourceUrl = (rawUrl: string): string => {
  const value = String(rawUrl || '').trim();
  if (!value) return '';
  try {
    const parsed = new URL(value);
    parsed.hash = '';
    for (const key of Array.from(parsed.searchParams.keys())) {
      if (/^utm_/i.test(key) || ['gclid', 'fbclid', 'ref', 'source'].includes(key.toLowerCase())) {
        parsed.searchParams.delete(key);
      }
    }
    const host = parsed.hostname.toLowerCase().replace(/^www\./, '');
    const pathname = parsed.pathname.replace(/\/+$/, '') || '/';
    const search = parsed.searchParams.toString();
    return `${host}${pathname}${search ? `?${search}` : ''}`;
  } catch {
    return value.toLowerCase().replace(/\/+$/, '');
  }
};

const isLikelyStorySource = (normalizedUrl: string): boolean => {
  const value = String(normalizedUrl || '').toLowerCase();
  if (!value) return false;
  if (/[?&](page|start|offset)=/.test(value)) return false;
  if (/(\/rss\/?|\/feed\/?|\/tag\/?|\/topic\/?|\/section\/?|\/category\/?|\/sitemap|\/latest|\/world\/?$|\/business\/?$|\/technology\/?$)/.test(value)) {
    return false;
  }
  return value.split('/').filter(Boolean).length >= 2;
};

const getStorySources = (post: Post): Set<string> => {
  const urls = Array.isArray(post.sources) ? post.sources.map((source) => normalizeSourceUrl(String(source?.url || ''))) : [];
  return new Set(urls.filter((url) => url && isLikelyStorySource(url)));
};

const hasStrongSourceOverlap = (candidate: Post, existing: Post): boolean => {
  const candidateSources = getStorySources(candidate);
  const existingSources = getStorySources(existing);
  if (candidateSources.size === 0 || existingSources.size === 0) return false;
  for (const source of candidateSources) {
    if (existingSources.has(source)) return true;
  }
  return false;
};

const areNearDuplicates = (candidate: Post, existing: Post): boolean => {
  const hoursApart = Math.abs(candidate.publishDate.valueOf() - existing.publishDate.valueOf()) / (1000 * 60 * 60);
  if (hoursApart > DUPLICATE_WINDOW_HOURS) return false;

  const similarity = titleSimilarityScore(candidate.title, existing.title);
  const sameTopic = !!candidate.topic_id && candidate.topic_id === existing.topic_id;
  const sameSection = !!candidate.section_id && candidate.section_id === existing.section_id;
  const sourceOverlap = hasStrongSourceOverlap(candidate, existing);

  if (sourceOverlap && similarity >= 0.28) return true;
  if (sameTopic && similarity >= 0.45) return true;
  if (sameSection && similarity >= 0.72) return true;
  return similarity >= 0.86;
};

const latestPosts = posts.reduce<Post[]>((acc, post) => {
  const hasDuplicate = acc.some((existing) => areNearDuplicates(post, existing));
  if (!hasDuplicate) acc.push(post);
  return acc;
}, []);

const metadata = {
  title: 'Latest — Foseer',
  description: 'The latest news and analysis from Foseer.',
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <header class="mb-12 border-b border-slate-200 dark:border-slate-700 pb-8">
        <div class="mb-4 flex items-center gap-3 text-sm text-muted dark:text-slate-400">
          <span class="text-primary dark:text-blue-400 font-semibold uppercase tracking-wide text-xs">Latest Coverage</span>
          <span class="text-gray-300 dark:text-slate-600">•</span>
          <time datetime={new Date().toISOString()} class="text-sm font-medium text-gray-600 dark:text-slate-300">
            Updated {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-gray-900 dark:text-white font-heading mb-4">
          Latest
        </h1>
        <p class="text-lg text-muted dark:text-slate-300 max-w-3xl leading-relaxed font-light">
          All recent stories and analysis from Foseer, updated regularly across news, business, tech, health, sports, and culture.
        </p>
      </header>

      {latestPosts.length === 0 ? (
        <p class="text-gray-600 dark:text-slate-400">No articles yet.</p>
      ) : (
        <>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="latest-grid">
            {latestPosts.slice(0, 12).map((post) => (
              <EditorialStoryCard post={post} variant="compact" />
            ))}
          </div>

          {latestPosts.length > 12 && (
            <div class="mt-12 text-center">
              <button
                id="load-more-btn"
                class="inline-flex items-center gap-2 px-8 py-3.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-semibold text-sm hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 dark:focus:ring-white"
                data-total={latestPosts.length}
                data-step="12"
                data-shown="12"
              >
                <span>Load More</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <p class="mt-3 text-sm text-muted dark:text-slate-400">
                Showing 12 of {latestPosts.length} articles
              </p>
            </div>
          )}

          <!-- Hidden container with remaining posts (visually hidden but DOM-accessible for mobile) -->
          <div id="hidden-posts" class="sr-only">
            {latestPosts.slice(12).map((post) => (
              <EditorialStoryCard post={post} variant="compact" />
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</Layout>

<LoadMore />
