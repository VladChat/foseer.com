---
// File: src/pages/article/[slug].astro
// Purpose: Article page for Foseer posts.

import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { fetchPosts, blogPostRobots } from '~/utils/blog';
import { resolvePostImage } from '~/utils/post-image';
import type { MetaData } from '~/types';

export const prerender = true;

export const getStaticPaths = (async () => {
  const posts = await fetchPosts();
  return posts.map((post) => ({
    params: {
      slug: post.slug,
    },
    props: { post },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const coverImage = await resolvePostImage(post.image, post.slug);

// Resolve image for metadata/OG/Twitter
let ogImage: { url: string | ImageMetadata; width?: number; height?: number } | undefined = undefined;
const metadataImageUrl = typeof post.imagePublicUrl === 'string' && post.imagePublicUrl.trim().startsWith('/')
  ? post.imagePublicUrl.trim()
  : null;
if (metadataImageUrl) {
  ogImage = { url: metadataImageUrl };
} else if (coverImage) {
  if (typeof coverImage === 'string') {
    ogImage = { url: coverImage };
  } else {
    ogImage = {
      url: coverImage,
      width: (coverImage as ImageMetadata).width,
      height: (coverImage as ImageMetadata).height,
    };
  }
}

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(ogImage ? { images: [ogImage] } : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;
---

<Layout metadata={metadata}>
  <SinglePost post={{ ...post, image: coverImage }} url={url}>
    {post.Content ? <post.Content /> : <Fragment set:html={post.content || ''} />}
  </SinglePost>
  <RelatedPosts post={post} />
</Layout>
