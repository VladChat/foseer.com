---
// File: src/pages/article/[slug].astro
// Purpose: Article page for Foseer posts.

import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { fetchPosts, blogPostRobots } from '~/utils/blog';
import { resolvePostImage } from '~/utils/post-image';
import type { MetaData, Post } from '~/types';

export const prerender = true;

export const getStaticPaths = (async () => {
  const posts = await fetchPosts();
  return posts.map((post) => ({
    params: {
      slug: post.slug,
    },
    props: { post },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const coverImage = await resolvePostImage(post.image, post.slug);

// Resolve image for metadata/OG/Twitter
let ogImage: { url: string | ImageMetadata; width?: number; height?: number } | undefined = undefined;
const metadataImageUrl = typeof post.imagePublicUrl === 'string' && post.imagePublicUrl.trim().startsWith('/')
  ? post.imagePublicUrl.trim()
  : null;
if (metadataImageUrl) {
  ogImage = { url: metadataImageUrl };
} else if (coverImage) {
  if (typeof coverImage === 'string') {
    ogImage = { url: coverImage };
  } else {
    ogImage = {
      url: coverImage,
      width: (coverImage as ImageMetadata).width,
      height: (coverImage as ImageMetadata).height,
    };
  }
}

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(ogImage ? { images: [ogImage] } : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;

// Split article content at the 2nd <h2> for YouTube block placement.
// YouTube will be rendered directly between the two parts, eliminating
// the need for post-render DOM relocation.
const youtubeVideo = (post as Post).youtube_video_id
  ? {
      videoId: String((post as Post).youtube_video_id).trim(),
      title: String((post as Post).youtube_video_title || '').trim(),
      channelTitle: String((post as Post).youtube_video_channel || '').trim(),
      duration: String((post as Post).youtube_video_duration || '').trim(),
      matchReason: String((post as Post).youtube_video_match_reason || '').trim(),
    }
  : null;

const rawContent = post.content || '';
const hasYoutubeAndRawContent = youtubeVideo && rawContent;

// Find the 2nd <h2> opening tag position in the HTML
let articleHtmlBefore: string | null = null;
let articleHtmlAfter: string | null = null;
if (hasYoutubeAndRawContent) {
  const h2Regex = /<h2[^>]*>/gi;
  const matches: number[] = [];
  let match;
  while ((match = h2Regex.exec(rawContent)) !== null) {
    matches.push(match.index);
    if (matches.length === 2) break;
  }
  if (matches.length === 2) {
    articleHtmlBefore = rawContent.substring(0, matches[1]);
    articleHtmlAfter = rawContent.substring(matches[1]);
  }
}
---

<Layout metadata={metadata}>
  <SinglePost
    post={{ ...post, image: coverImage }}
    url={url}
    articleHtmlBefore={articleHtmlBefore ?? undefined}
    articleHtmlAfter={articleHtmlAfter ?? undefined}
    youtubeVideo={youtubeVideo}
  >
    {articleHtmlBefore === null
      ? (post.Content ? <post.Content /> : <Fragment set:html={rawContent} />)
      : null}
  </SinglePost>
  <RelatedPosts post={post} />
</Layout>
