---
// File: src/pages/business/index.astro
// Purpose: Business & markets section landing page for Foseer.

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Business & markets — Foseer',
  description:
    'Companies, markets, startups, and personal money stories — focused on what changes for real people.',
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-4xl space-y-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Business &amp; markets
      </h1>

      <p class="text-base text-muted-foreground sm:text-lg">
        Earnings, market swings, layoffs, funding rounds, and new products — with an eye on how they
        affect workers, savers, and small operators.
      </p>

      <p class="text-sm text-muted-foreground sm:text-base">
        Over time this page will connect daily moves in the markets with longer stories about risk,
        opportunity, and how people adapt.
      </p>
    </div>
  </section>
</Layout>
