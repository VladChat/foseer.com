---
// File: src/pages/news/index.astro
// Purpose: Section landing page for Foseer news coverage.

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'News',
  description:
    'World, U.S. politics, and society stories with enough background to understand why they matter now.',
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl space-y-8">
      <header class="text-center mb-12 border-b border-slate-200 dark:border-slate-700 pb-8">
        <div class="mb-4 flex items-center justify-center gap-3 text-sm text-muted dark:text-slate-400">
          <span class="text-primary dark:text-blue-400 font-semibold uppercase tracking-wide text-xs">Editorial Desk</span>
          <span class="text-gray-300 dark:text-slate-600">•</span>
          <time datetime={new Date().toISOString()} class="text-sm font-medium text-gray-600 dark:text-slate-300">
            Updated {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-gray-900 dark:text-white font-heading mb-4">
          News
        </h1>
        <p class="text-lg text-muted dark:text-slate-300 max-w-3xl mx-auto leading-relaxed font-light text-justify">
          Big stories across world affairs, U.S. politics, and society — with clear context, timelines,
          and what to watch next. Our editorial team provides comprehensive coverage with the depth and analysis
          you need to stay informed.
        </p>
      </header>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div class="bg-gradient-to-br from-primary/5 to-blue-50/5 dark:from-blue-900/10 dark:to-slate-800/20 rounded-xl p-6 border border-slate-200 dark:border-slate-700">
          <h2 class="text-xl font-bold mb-3 text-gray-900 dark:text-white font-heading">World Affairs</h2>
          <p class="text-muted dark:text-slate-400 mb-4">Global conflicts, international relations, and geopolitical developments that shape our interconnected world.</p>
          <a href="/sections/news/global-conflicts/" class="text-primary dark:text-blue-400 hover:underline font-medium">Explore coverage →</a>
        </div>
        <div class="bg-gradient-to-br from-primary/5 to-blue-50/5 dark:from-blue-900/10 dark:to-slate-800/20 rounded-xl p-6 border border-slate-200 dark:border-slate-700">
          <h2 class="text-xl font-bold mb-3 text-gray-900 dark:text-white font-heading">U.S. Politics</h2>
          <p class="text-muted dark:text-slate-400 mb-4">Congress, elections, policy developments, and political analysis from Washington and across America.</p>
          <a href="/sections/news/us-politics/" class="text-primary dark:text-blue-400 hover:underline font-medium">Explore coverage →</a>
        </div>
        <div class="bg-gradient-to-br from-primary/5 to-blue-50/5 dark:from-blue-900/10 dark:to-slate-800/20 rounded-xl p-6 border border-slate-200 dark:border-slate-700">
          <h2 class="text-xl font-bold mb-3 text-gray-900 dark:text-white font-heading">Society & Culture</h2>
          <p class="text-muted dark:text-slate-400 mb-4">Social trends, cultural shifts, and the human stories that define our times.</p>
          <a href="/sections/news/society/" class="text-primary dark:text-blue-400 hover:underline font-medium">Explore coverage →</a>
        </div>
      </div>

      <div class="mt-12 text-center max-w-2xl mx-auto">
        <p class="text-muted dark:text-slate-400 mb-6">
          This page collects the latest coverage and explainers from the news cycle. Our editorial team
          continuously updates this section with comprehensive analysis and timely reporting.
        </p>
        <a href="/blog" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors font-medium">
          <span>View All Coverage</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
