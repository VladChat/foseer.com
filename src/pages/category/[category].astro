---
// File: src/pages/category/[category].astro
// Purpose: Static category landing page for article categories.

import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import EditorialStoryCard from '~/components/EditorialStoryCard.astro';
import { fetchPosts } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async () => {
  const posts = await fetchPosts();
  const byCategory = new Map();

  for (const post of posts) {
    if (!post.category?.slug) continue;
    const entry = byCategory.get(post.category.slug) || { category: post.category, posts: [] };
    entry.posts.push(post);
    byCategory.set(post.category.slug, entry);
  }

  return Array.from(byCategory.values()).map(({ category, posts }) => ({
    params: { category: category.slug },
    props: { category, posts },
  }));
}) satisfies GetStaticPaths;

const { category, posts = [] } = Astro.props;

const metadata = {
  title: `${category?.title || 'Category'} — Foseer`,
  description: `Coverage filed under ${category?.title || 'category'} on Foseer.`,
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <header class="mb-12 border-b border-slate-200 dark:border-slate-700 pb-8">
        <div class="mb-4 flex items-center gap-3 text-sm text-muted dark:text-slate-400">
          <span class="text-primary dark:text-blue-400 font-semibold uppercase tracking-wide text-xs">Category</span>
          <span class="text-gray-300 dark:text-slate-600">•</span>
          <span class="text-sm font-medium text-gray-600 dark:text-slate-300">{posts.length} article{posts.length === 1 ? '' : 's'}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-gray-900 dark:text-white font-heading mb-4">{category?.title}</h1>
        <p class="text-lg text-muted dark:text-slate-300 max-w-3xl leading-relaxed font-light">Coverage collected under the {category?.title} desk.</p>
      </header>

      {posts.length === 0 ? (
        <p class="text-gray-600 dark:text-slate-400">No articles found for this category.</p>
      ) : (
        <>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="category-grid">
            {posts.slice(0, 12).map((post) => (
              <EditorialStoryCard post={post} variant="compact" />
            ))}
          </div>

          {posts.length > 12 && (
            <div class="mt-12 text-center">
              <button
                id="load-more-btn"
                class="inline-flex items-center gap-2 px-8 py-3.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-semibold text-sm hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 dark:focus:ring-white"
                data-total={posts.length}
                data-step="12"
              >
                <span>Load More</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <p class="mt-3 text-sm text-muted dark:text-slate-400">
                Showing 12 of {posts.length} articles
              </p>
            </div>
          )}

          <!-- Hidden container with remaining posts -->
          <div id="hidden-posts" class="hidden">
            {posts.slice(12).map((post) => (
              <EditorialStoryCard post={post} variant="compact" />
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</Layout>

<script>
  // Load More functionality for category pages
  const loadMoreBtn = document.getElementById('load-more-btn');
  const hiddenPostsContainer = document.getElementById('hidden-posts');
  const categoryGrid = document.getElementById('category-grid');

  if (loadMoreBtn && hiddenPostsContainer && categoryGrid) {
    const totalPosts = parseInt(loadMoreBtn.dataset.total || '0');
    const step = parseInt(loadMoreBtn.dataset.step || '12');
    let shownCount = 12;

    const hiddenCards = Array.from(hiddenPostsContainer.children);

    loadMoreBtn.addEventListener('click', () => {
      const remaining = hiddenCards.length - (shownCount - 12);
      const toShow = Math.min(step, remaining);

      for (let i = 0; i < toShow; i++) {
        const card = hiddenCards[shownCount - 12 + i];
        if (card) {
          categoryGrid.appendChild(card);
        }
      }

      shownCount += toShow;

      // Update counter text
      const counterText = loadMoreBtn.parentElement?.querySelector('p');
      if (counterText) {
        counterText.textContent = `Showing ${shownCount} of ${totalPosts} articles`;
      }

      // Hide button if all posts shown
      if (shownCount >= totalPosts) {
        loadMoreBtn.parentElement?.remove();
      }
    });
  }
</script>
