---
// File: src/pages/about.astro
// Purpose: About Foseer page.

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Foseer',
  description: 'Foseer is a news and analysis website covering news, business, tech, health, sports, and culture.',
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <header class="mb-12 border-b border-slate-200 dark:border-slate-700 pb-8">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white font-heading mb-4">
          About Foseer
        </h1>
      </header>

      <div class="prose prose-lg dark:prose-invert">
        <p class="text-lg text-gray-700 dark:text-slate-300 leading-relaxed">
          Foseer is a news and analysis website dedicated to clear, contextual coverage of the stories shaping public life, business, technology, health, sports, and culture.
        </p>

        <h2>Our Mission</h2>
        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          In an era of information overload, Foseer cuts through the noise. Readers deserve more than headlines. They deserve context, structure, and a clean way to follow important developments over time.
        </p>

        <h2>What We Cover</h2>
        <ul class="text-gray-700 dark:text-slate-300">
          <li><strong>News:</strong> U.S. politics, world events, law, climate, and social change</li>
          <li><strong>Business:</strong> Markets, companies, consumer money, housing, crypto, and travel issues</li>
          <li><strong>Tech:</strong> AI, consumer tech, cybersecurity, mobility, space, and platforms</li>
          <li><strong>Health:</strong> Public health, research, pharma, mental health, and wellness</li>
          <li><strong>Sports:</strong> Leagues, events, transfers, and athlete-driven culture</li>
          <li><strong>Culture:</strong> Film, TV, music, internet culture, and creator platforms</li>
        </ul>

        <h2>Our Approach</h2>
        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          Foseer combines timely reporting with structured analysis. Each story aims to answer three questions: what happened, why it matters, and what to watch next.
        </p>

        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          We organize coverage by section and topic so readers can move from the latest update to deeper follow-up without losing the thread.
        </p>
      </div>
    </div>
  </section>
</Layout>
