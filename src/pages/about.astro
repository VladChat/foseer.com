---
// File: src/pages/about.astro
// Purpose: About Foseer page.

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Foseer',
  description: 'Foseer is a news and analysis website covering business, technology, politics, and science.',
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <header class="mb-12 border-b border-slate-200 dark:border-slate-700 pb-8">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white font-heading mb-4">
          About Foseer
        </h1>
      </header>

      <div class="prose prose-lg dark:prose-invert">
        <p class="text-lg text-gray-700 dark:text-slate-300 leading-relaxed">
          Foseer is a news and analysis website dedicated to providing clear, contextual coverage of the stories that shape our world. We focus on business, technology, politics, society, and science — delivering not just what happened, but why it matters.
        </p>

        <h2>Our Mission</h2>
        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          In an era of information overload, Foseer cuts through the noise. We believe readers deserve more than headlines — they deserve context, analysis, and the connections between events that reveal the bigger picture.
        </p>

        <h2>What We Cover</h2>
        <ul class="text-gray-700 dark:text-slate-300">
          <li><strong>News:</strong> World affairs, U.S. politics, and global conflicts</li>
          <li><strong>Technology:</strong> AI, cybersecurity, gadgets, and digital culture</li>
          <li><strong>Business:</strong> Markets, companies, startups, and personal finance</li>
          <li><strong>Science:</strong> Space, climate, health, and research breakthroughs</li>
        </ul>

        <h2>Our Approach</h2>
        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          Foseer combines timely reporting with explanatory journalism. Each story answers three questions: What's happening? Why does it matter? What should you watch next?
        </p>

        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          We organize coverage by topic so readers can follow developing stories over time — from daily updates to long-term trends.
        </p>
      </div>
    </div>
  </section>
</Layout>
