---
// File: src/pages/about.astro
// Purpose: About Foseer page.

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Foseer',
  description: 'Foseer is an independent digital publication covering news, business, tech, health, sports, and culture with a focus on clarity, context, and signal over noise.',
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <header class="mb-12 border-b border-slate-200 dark:border-slate-700 pb-8">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white font-heading mb-4">
          About Foseer
        </h1>
      </header>

      <div class="prose prose-lg dark:prose-invert">
        <p class="text-lg text-gray-700 dark:text-slate-300 leading-relaxed">
          Foseer is an independent digital publication covering news, business, tech, health, sports, and culture with a focus on clarity, context, and signal over noise.
        </p>

        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          We built Foseer to help readers follow important stories without the clutter, recycled framing, or low-value volume that often surrounds fast-moving coverage. Our goal is to make major developments easier to understand, easier to compare, and easier to revisit.
        </p>

        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          Our coverage includes breaking developments, explainers, analysis, and ongoing topic reporting across core public-interest desks. We aim to present timely information clearly, add useful context, and help readers understand not only what happened, but why it matters.
        </p>

        <h2>Our Approach</h2>
        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          Foseer is intentionally simple, fast, and reading-first. We publish with an emphasis on transparency, editorial accountability, and practical usefulness for readers.
        </p>

        <h2>Contact</h2>
        <p class="text-gray-700 dark:text-slate-300 leading-relaxed">
          For questions, tips, corrections, or business inquiries, contact <a href="mailto:info@foseer.com" class="text-primary hover:underline">info@foseer.com</a> or <a href="tel:+12245329236" class="text-primary hover:underline">(224) 532-9236</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
