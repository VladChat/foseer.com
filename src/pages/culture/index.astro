---
// File: src/pages/culture/index.astro
// Purpose: Culture & media section landing page for Foseer.

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Culture & media — Foseer',
  description:
    'Streaming, celebrities, internet culture, and the stories people talk about for days.',
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-4xl space-y-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Culture &amp; media
      </h1>

      <p class="text-base text-muted-foreground sm:text-lg">
        Movies, shows, music, viral posts, and other moments where culture, media, and the internet
        collide.
      </p>

      <p class="text-sm text-muted-foreground sm:text-base">
        This section will mix lighter stories with smart context — what&apos;s fun, what&apos;s
        weird, and what it all might mean.
      </p>
    </div>
  </section>
</Layout>
