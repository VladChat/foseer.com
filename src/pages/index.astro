---
// File: src/pages/index.astro
// Purpose: Home page for Foseer — hero, trending topics, key sections, and latest long reads.

import Layout from '~/layouts/PageLayout.astro';

import EditorialStoryCard from '~/components/EditorialStoryCard.astro';
import TrendingTopics from '~/components/TrendingTopics.astro';
import TopSections from '~/components/TopSections.astro';
import { fetchPosts } from '~/utils/blog';
import { getBlogPermalink, getAsset } from '~/utils/permalinks';

const metadata = {
  title: 'Foseer — News and analysis with context',
  description:
    'Clear reporting and analysis across news, business, tech, health, sports, and culture — built to help readers understand what matters now.',
  ignoreTitleTemplate: true,
};

const posts = await fetchPosts();
const leadStory = posts[0];
const featuredStories = posts.slice(1, 4);
const latestCoverage = posts.slice(0, 6);
const editorsPickSlugs = ['extreme-weather-explained', 'us-election-2025-what-to-know', 'nvidia-surges-again-why-it-matters'];
const editorPicks = posts.filter((post) => editorsPickSlugs.includes(post.slug));
const headlineRail = posts.slice(1, 5);
---

<Layout metadata={metadata}>
  <section class="border-b border-slate-200 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 md:py-12 lg:py-14">
      <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="mb-2 flex items-center gap-2 text-sm text-muted dark:text-slate-400">
            <span class="text-primary dark:text-blue-400 font-semibold uppercase tracking-wide text-xs">Editorial Desk</span>
            <span class="text-gray-300 dark:text-slate-600">•</span>
            <time datetime={new Date().toISOString()} class="text-sm font-medium text-gray-600 dark:text-slate-300">
              Updated {new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
          <h1 class="mt-1 max-w-3xl font-heading text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100 md:text-3xl">
            Today's Edition
          </h1>
        </div>
        <p class="max-w-xl text-sm leading-6 text-slate-600 dark:text-slate-400">
          Lead coverage, sharp analysis, and the latest reporting from across the newsroom.
        </p>
      </div>

      {leadStory && (
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1.65fr)_minmax(320px,0.95fr)]">
          <EditorialStoryCard post={leadStory} variant="lead" />

          <aside class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900">
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-accent">Early edition</p>
            <h2 class="mt-2 font-heading text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
              Developing now
            </h2>
            <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
              Quick updates on stories still moving.
            </p>

            <ul class="mt-6 space-y-4">
              {headlineRail.map((post, index) => (
                <li class="border-t border-slate-200 pt-4 first:border-t-0 first:pt-0 dark:border-slate-800">
                  <div class="mb-1 text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-slate-500 dark:text-slate-400">
                    {String(index + 1).padStart(2, '0')}
                  </div>
                  <a
                    class="font-heading text-lg font-semibold leading-snug text-slate-900 hover:text-primary dark:text-slate-100"
                    href={`/${post.permalink}`}
                  >
                    {post.title}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      )}
    </div>
  </section>

  {featuredStories.length > 0 && (
    <section class="border-b border-slate-200 dark:border-slate-800">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 md:py-12">
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-accent">Featured coverage</p>
            <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
              More from the front page
            </h2>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {featuredStories.map((post) => (
            <EditorialStoryCard post={post} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-b border-slate-200 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 md:py-12">
      <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.1em] text-accent">Latest coverage</p>
          <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
            New reporting and analysis
          </h2>
        </div>
        <a class="text-sm font-semibold uppercase tracking-[0.08em] text-primary hover:text-secondary" href={getBlogPermalink()}>
          View all coverage →
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {latestCoverage.map((post) => (
          <EditorialStoryCard post={post} variant="compact" showExcerpt={false} />
        ))}
      </div>
    </div>
  </section>

  <div id="trending">
    <TrendingTopics />
  </div>

  <TopSections />

  <section class="border-t border-slate-200 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 md:py-12">
      <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.1em] text-accent">Editor’s picks</p>
          <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
            Context worth revisiting
          </h2>
        </div>
        <p class="max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-300">
          A small selection of stories and analysis that add perspective beyond the day’s fastest
          headlines.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {editorPicks.map((post) => (
          <EditorialStoryCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rounded-3xl bg-slate-950 px-6 py-8 text-slate-100 shadow-xl md:px-10 md:py-10">
        <div class="grid gap-6 md:grid-cols-[minmax(0,1.4fr)_auto] md:items-end">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-slate-300">Follow Foseer</p>
            <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-white md:text-4xl">
              Stay close to the next story.
            </h2>
            <p class="mt-3 max-w-2xl text-base leading-7 text-slate-300">
              Foseer remains intentionally simple and static-first. For now, follow new reporting via
              the latest coverage page or subscribe through the RSS feed.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              class="inline-flex items-center justify-center rounded-md bg-white px-5 py-3 text-sm font-semibold uppercase tracking-[0.05em] text-slate-950 transition hover:bg-slate-200"
              href={getBlogPermalink()}
            >
              Latest coverage
            </a>
            <a
              class="inline-flex items-center justify-center rounded-md border border-slate-600 px-5 py-3 text-sm font-semibold uppercase tracking-[0.05em] text-white transition hover:border-slate-400 hover:bg-slate-900"
              href={getAsset('/rss.xml')}
            >
              RSS feed
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
