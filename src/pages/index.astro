---
// File: src/pages/index.astro
// Purpose: Home page for Foseer — hero, trending topics, key sections, and latest long reads.

import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

import TrendingTopics from '~/components/TrendingTopics.astro';
import TopSections from '~/components/TopSections.astro';

const metadata = {
  title: 'Foseer — Where Insight Becomes Opportunity',
  description:
    'Smart news, trends, tools, and ideas translated into action — helping you see what matters and what comes next.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: "Read today's highlights",
        href: '#trending',
        icon: 'tabler:news',
      },
      {
        text: 'About Foseer',
        href: '#how-it-works',
      },
    ]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'Overview of Foseer news and analysis',
    }}
  >
    <Fragment slot="title">
      Foseer — <span class="text-accent dark:text-white">Look ahead</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Smart news, trends, tools, and ideas translated into action — so you can see what is forming
        now and decide what to do next.
      </span>
      <span class="block sm:hidden">
        Headlines, context, and what comes next — in one place.
      </span>
    </Fragment>
  </Hero>

  <div id="trending">
    <TrendingTopics />
  </div>

  <TopSections />

  <div id="how-it-works">
    <Content
      tagline="Our approach"
      title="How we cover the stories that matter"
      items={[
        {
          title: 'We follow the news cycle',
          description:
            'Editors track breaking headlines, ongoing developments, and quieter shifts that will matter tomorrow, not just today.',
        },
        {
          title: 'We connect dots across topics',
          description:
            'Instead of treating each story in isolation, we look at how events in markets, technology, politics, and society influence one another.',
        },
        {
          title: 'We focus on meaning, not noise',
          description:
            'Each piece aims to answer a simple question: what does this really mean for people, businesses, and everyday life?',
        },
      ]}
      image={{
        src: 'https://images.unsplash.com/photo-1553877522-43269d4ea984?auto=format&fit=crop&w=1400&q=80',
        alt: 'Editors reviewing stories and notes',
      }}
    >
      <Fragment slot="content">
        <h3 class="mb-2 text-2xl font-bold tracking-tight dark:text-white sm:text-3xl">
          A newsroom that looks a step ahead
        </h3>
        We try to stay slightly ahead of the curve: not just repeating what happened, but explaining
        why it matters and what might come next.
      </Fragment>
    </Content>
  </div>

  <BlogLatestPosts
    title="Latest analysis and long reads"
    information="Long-form explainers, timelines, and deeper context behind the headlines — for when a short news update is not enough."
  />
</Layout>
