---
// File: src/pages/science/index.astro
// Purpose: Science & innovation section landing page for Foseer.

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Science & innovation — Foseer',
  description:
    'Space, climate, health, and new research — explained without jargon.',
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-4xl space-y-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Science &amp; innovation
      </h1>

      <p class="text-base text-muted-foreground sm:text-lg">
        Launches, missions, extreme weather, medical breakthroughs, and other signals from science
        and research.
      </p>

      <p class="text-sm text-muted-foreground sm:text-base">
        As coverage grows, this page will organise stories so readers can follow both slow-moving
        trends and sudden breakthroughs.
      </p>
    </div>
  </section>
</Layout>
