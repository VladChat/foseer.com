---
// File: src/pages/technology/index.astro
// Purpose: Technology section landing page for Foseer.

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Technology — Foseer',
  description:
    'AI, platforms, gadgets, and the tools people actually use — explained in plain language.',
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-4xl space-y-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Technology
      </h1>

      <p class="text-base text-muted-foreground sm:text-lg">
        From AI assistants and big tech platforms to consumer gadgets and cybersecurity — this
        section follows how technology changes work, money, and everyday life.
      </p>

      <p class="text-sm text-muted-foreground sm:text-base">
        As stories are added, this page will surface both quick updates and slower explainers, so
        readers can jump in at their own depth.
      </p>
    </div>
  </section>
</Layout>
